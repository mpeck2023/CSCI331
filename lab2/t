def occurs(var,term):
    if var == term:
        return True
    return any(occurs(var,arg) for arg in term.args)

def unifyVar(var, x, theta):
    if var in theta.keys():
        return unify(theta[var],x,theta)
    elif x in theta.keys():
        return unify(var, theta[x],theta)
    elif occurs(var,x):
        return None
    else:
        theta[var] = x
        return theta
    
def unify(x,y,theta=None):
    # print("\033[93m{0} {1}".format(x, y)) #print here
    if theta is None:
        theta = {}
    if x == y:
        return theta
    
    elif x in variables:
        # print("\033[93m{0} in variables".format(x)) #print here
        return unifyVar(x,y,theta)
    elif y in variables:
        # print("\033[94m{0} in variables".format(x)) #print here
        return unifyVar(y,x,theta)
    
    elif isinstance(x,Term) and isinstance(y,Term):
        if x.name != y.name or len(x.args) != len(x.args):
            return None

        theta = unify(x[0],y[0],theta)
        if theta == None:
            return None
        
        return unify(x[1:],y[1:],theta)
    else:
        return None

def isComplementary(predicate1,predicate2):
    theta = unify(predicate1[0],predicate2[0])
    return theta is not None and predicate1[1]!=predicate2[1], theta

def apply_unification(term, theta):
    if term in theta:
        return theta[term]
    return Term(term.name, tuple(apply_unification(arg, theta) for arg in term.args))




def resolve(clause1, clause2):
    resolved_clauses = set()
    # print("\033[0m{0} \033[92m{1}".format(clause1,clause2)) #print here
    for predicate1 in clause1:
        for predicate2 in clause2:
            complementary, theta = isComplementary(predicate1,predicate2)
            if complementary:
                new_clause = (set(clause1) - {predicate1}) | (set(clause2) - {predicate2})
                unified_clause = set()
                # print("\033[91m{0}".format(new_clause)) #print here
                for predicate, not_negative in new_clause:
                    unified_predicate = apply_unification(predicate, theta)
                    unified_clause.add((unified_predicate,not_negative))
                # print("\033[94m{0}".format(unified_clause)) #print here
                resolved_clauses.add(Clause(unified_clause))
                # print(theta)
    # print("{0}".format(resolved_clauses)) #print here
    return(resolved_clauses)
                
def resolution(knowledge_base):
    while True:
        new = set()

        clauses = list(knowledge_base)
        for i in range(len(clauses)):
            for j in range(i + 1, len(clauses)):

                resolved_clauses = resolve(clauses[i],clauses[j])

                if () in resolved_clauses:
                    return "no"
                
                new |= resolved_clauses

        if new.issubset(knowledge_base):
            return "yes"
        knowledge_base |= new
        
