def parseTerm(term):
    if "(" not in term:
        return Term(term)
    
    name, args = term.split('(',1)
    args = args[:-1].split(',')
    parsed_args = tuple(parseTerm(arg) for arg in args)

    return Term(name, parsed_args)

def parseClauses(clauses):
    knowledge_base = set()
    for clause in clauses:
        literals = set()
        for predicate in clause:
            sign = True
            if predicate.startswith("!"):
                predicate = predicate[1:]
                sign = False
            literals.add((parseTerm(predicate), sign))
        knowledge_base.add(Clause(literals))
    return knowledge_base

